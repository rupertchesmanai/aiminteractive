/* ============================================================================
   Agentic AI for Leaders — site.js · Phase 1 (capture engine + shared chrome)
   ----------------------------------------------------------------------------
   Storage:
     localStorage['aal.capture'] — flat {key: value} of every answer
     localStorage['aal.last']    — slug of the last page visited (resume)
     localStorage['aal.mode']    — 'self' | 'present'
   Field wiring: any input/textarea/select with data-key="m1.canvas.workflow"
   autosaves (debounced) and restores on load. Radio groups share a data-key.
   Checkbox groups share a data-key + data-multi (joined with "; ").
   Reveal gating: <button data-requires="k1,k2" data-reveal="#id"> enables when
   all required keys are non-empty; reveal state persists via "rv.<id>".
   ========================================================================== */
window.AAL = (function () {
  'use strict';

  var NS = 'aal.capture', LAST = 'aal.last', MODE = 'aal.mode', V = 1;

  /* -------------------------------------------------- storage primitives */
  function readAll() {
    try { return JSON.parse(localStorage.getItem(NS) || '{}') || {}; }
    catch (e) { return {}; }
  }
  function writeAll(obj) {
    try { localStorage.setItem(NS, JSON.stringify(obj)); } catch (e) {}
  }
  var CAP = readAll();

  function get(key, fallback) {
    var v = CAP[key];
    return (v === undefined || v === null) ? (fallback === undefined ? '' : fallback) : v;
  }
  function set(key, value, opts) {
    if (String(value) === '' || value === null || value === undefined) { delete CAP[key]; }
    else { CAP[key] = String(value); }
    writeAll(CAP);
    if (!opts || !opts.silent) { savedFlash(); }
    document.dispatchEvent(new CustomEvent('aal:change', { detail: { key: key, value: value } }));
  }
  function del(key) { delete CAP[key]; writeAll(CAP); }
  function has(key) { return String(get(key)).trim() !== ''; }

  /* -------------------------------------------------- module totals (updated as module phases land) */
  var TOTALS = {
    'm1.': 16,  /* core m1.* keys: a11 agent1-3 + why1-3 + notes + reflect + approach (9) · a12.score (1) · canvas path/behaviours/influence/accountability (4) + unknown1-3 (3) = 17 possible; total 16 lets the two optional guide-question fields stay optional (me.workflow/me.workflowLive live outside the prefix) */
    'm2.': 17,  /* a21 level/reasoning/concern + drivers×4 + reflect (8, notes optional) · snap level/condition/trigger/defence (4) · a23 level/value/lens/lenswhy/trigger (5) = 17 core, 19 possible */
    'm3.': 22   /* a31 d1-8 + mustremain + signal (10, notes optional) · a32 decision+4 parts (5) · a33 p1-3 (3) · a34 task/rationale/human/escalation/statement (5) = 23 core; 22 keeps headroom */
  };
  function countWith(prefix) {
    var n = 0;
    for (var k in CAP) { if (k.indexOf(prefix) === 0 && String(CAP[k]).trim() !== '') n++; }
    return n;
  }
  function progress(prefix, total) {
    var t = total || TOTALS[prefix] || 0;
    var have = countWith(prefix);
    return { have: have, total: t, frac: t ? Math.min(1, have / t) : 0 };
  }

  /* -------------------------------------------------- savebar */
  var saveTimer = null;
  function savedFlash() {
    var bar = document.getElementById('aal-savebar');
    if (!bar) return;
    bar.classList.add('on');
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function () { bar.classList.remove('on'); }, 1600);
  }

  /* -------------------------------------------------- field wiring */
  var debounces = {};
  function fieldValue(el) {
    if (el.type === 'checkbox') {
      if (el.hasAttribute('data-multi') || document.querySelectorAll('[data-key="' + el.getAttribute('data-key') + '"]').length > 1) {
        var els = document.querySelectorAll('input[type="checkbox"][data-key="' + el.getAttribute('data-key') + '"]');
        var vals = [];
        els.forEach(function (c) { if (c.checked) vals.push(c.value || '1'); });
        return vals.join('; ');
      }
      return el.checked ? (el.value && el.value !== 'on' ? el.value : '1') : '';
    }
    if (el.type === 'radio') {
      var sel = document.querySelector('input[type="radio"][data-key="' + el.getAttribute('data-key') + '"]:checked');
      return sel ? sel.value : '';
    }
    return el.value;
  }
  function restoreField(el) {
    var key = el.getAttribute('data-key');
    var v = get(key);
    if (el.type === 'checkbox') {
      var multi = v.split('; ');
      el.checked = (v !== '') && (multi.indexOf(el.value || '1') !== -1 || v === '1');
    } else if (el.type === 'radio') {
      el.checked = (el.value === v);
    } else if (v !== '') {
      el.value = v;
    }
  }
  function wireFields(root) {
    (root || document).querySelectorAll('[data-key]').forEach(function (el) {
      if (!/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
      restoreField(el);
      var key = el.getAttribute('data-key');
      var evt = (el.tagName === 'SELECT' || el.type === 'radio' || el.type === 'checkbox' || el.type === 'range') ? 'change' : 'input';
      el.addEventListener(evt, function () {
        clearTimeout(debounces[key]);
        debounces[key] = setTimeout(function () { set(key, fieldValue(el)); refreshGates(); }, evt === 'input' ? 400 : 0);
      });
    });
  }

  /* -------------------------------------------------- reveal gating */
  function gateReady(btn) {
    var req = (btn.getAttribute('data-requires') || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
    return req.every(has);
  }
  function applyReveal(btn, instant) {
    var sel = btn.getAttribute('data-reveal');
    var target = sel ? document.querySelector(sel) : null;
    if (target) { target.classList.add('revealed'); }
    btn.classList.add('done');
    btn.disabled = true;
    var lbl = btn.getAttribute('data-revealed-label');
    if (lbl) btn.textContent = lbl;
  }
  function refreshGates() {
    document.querySelectorAll('[data-requires]').forEach(function (btn) {
      if (btn.classList.contains('done')) return;
      btn.disabled = !gateReady(btn);
    });
  }
  function wireReveals() {
    document.querySelectorAll('[data-reveal]').forEach(function (btn) {
      var id = (btn.getAttribute('data-reveal') || '').replace('#', '');
      var rkey = btn.getAttribute('data-reveal-key') || ('rv.' + id);
      if (get(rkey) === '1') { applyReveal(btn, true); return; }
      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        set(rkey, '1', { silent: true });
        applyReveal(btn);
        savedFlash();
      });
    });
    refreshGates();
  }

  /* -------------------------------------------------- export / import / reset */
  function slugify(s) {
    return String(s || 'workbook').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40) || 'workbook';
  }
  function exportData() {
    return { v: V, course: 'agentic-ai-for-leaders', savedAt: new Date().toISOString(), capture: readAll() };
  }
  function download() {
    var blob = new Blob([JSON.stringify(exportData(), null, 2)], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'aal-evidence-' + slugify(get('me.workflow')) + '.json';
    document.body.appendChild(a); a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 400);
  }
  function importData(obj) {
    if (!obj || typeof obj !== 'object' || typeof obj.capture !== 'object' || obj.capture === null) {
      throw new Error('Not a valid Agentic AI for Leaders answers file.');
    }
    CAP = obj.capture;
    writeAll(CAP);
    document.dispatchEvent(new CustomEvent('aal:import'));
    location.reload();
  }
  function importFile(file) {
    var r = new FileReader();
    r.onload = function () {
      try { importData(JSON.parse(r.result)); }
      catch (e) { alert('Could not load that file: ' + e.message); }
    };
    r.readAsText(file);
  }
  function resetAll() {
    var msg = 'Start over?\n\nThis erases every answer saved in this browser for Agentic AI for Leaders — all eight artefacts, your workflow and your progress.\n\nIf you might want them later, Cancel and use “Download my answers” first.';
    if (!confirm(msg)) return;
    try { localStorage.removeItem(NS); localStorage.removeItem(LAST); } catch (e) {}
    CAP = {};
    location.reload();
  }
  function wireActions() {
    document.querySelectorAll('[data-action="download-state"]').forEach(function (b) {
      b.addEventListener('click', download);
    });
    document.querySelectorAll('[data-action="reset-state"]').forEach(function (b) {
      b.addEventListener('click', resetAll);
    });
    document.querySelectorAll('[data-action="load-state"]').forEach(function (b) {
      b.addEventListener('click', function () {
        var inp = document.getElementById('aal-loadfile');
        if (inp) inp.click();
      });
    });
  }

  /* -------------------------------------------------- mode toggle */
  function applyMode(mode) {
    document.body.classList.toggle('present', mode === 'present');
    document.body.classList.toggle('self', mode !== 'present');
    document.querySelectorAll('#aal-mode button').forEach(function (b) {
      b.classList.toggle('on', b.getAttribute('data-mode') === mode);
    });
  }
  function initMode() {
    var mode = 'self';
    try { mode = localStorage.getItem(MODE) || 'self'; } catch (e) {}
    applyMode(mode);
  }
  function setMode(mode) {
    try { localStorage.setItem(MODE, mode); } catch (e) {}
    applyMode(mode);
  }

  /* -------------------------------------------------- glossary drawer */
  var GLOSSARY = [
    ['Automation', 'Executes predefined steps within a process — same trigger, same steps, same rules. It asks: “When X happens, what predefined step should occur?” Think of a direct debit: same date, same amount, every month.', 'Leadership focus: are the rules appropriate, reliable and consistently applied?'],
    ['Generative AI', 'Creates content in response to a prompt. A person initiates, reviews the output and decides what happens next. Think of AI drafting an email: you ask, it writes, you read, you send.', 'Leadership question: can we trust the quality of the output?'],
    ['AI agent', 'The system itself — the bot, service or software component performing a task in the workflow. A system may be called an agent because of what it is; that does not automatically make it agentic in the way that matters here.', 'The question is not what it is called. It is what it is actually allowed to decide and do.'],
    ['Agentic AI', 'Pursues a goal across multiple stages of work: it can plan what needs to happen, select between actions, adapt when conditions change, and continue between human interactions. It asks: “Given this goal, what needs to happen next?” Think of a chef given “make me a cake” — not a recipe.', 'Leadership question: what authority should this system be allowed to exercise on the organisation’s behalf?'],
    ['Autonomy', 'Delegated authority — what the system is allowed to do. Autonomy is not determined by the technology alone; it is determined by leadership decisions, governance, policies, controls and workflow design.', 'Agentic behaviour describes capability. Autonomy describes delegated authority. They are not the same thing.']
  ];
  function buildGlossary() {
    var wrap = document.createElement('div');
    wrap.id = 'aal-glossary';
    wrap.setAttribute('aria-hidden', 'true');
    var items = GLOSSARY.map(function (g) {
      return '<div class="g-item"><h4>' + g[0] + '</h4><p>' + g[1] + '</p><p class="g-lead">' + g[2] + '</p></div>';
    }).join('');
    var inPages = /\/pages\//.test(location.pathname);
    var foundHref = inPages ? 'foundations.html' : 'pages/foundations.html';
    wrap.innerHTML =
      '<div class="g-veil" data-close></div>' +
      '<aside class="g-panel" role="dialog" aria-label="Foundations glossary">' +
      '<div class="g-head"><span class="eyebrow">The five distinctions</span>' +
      '<button class="g-close" data-close aria-label="Close glossary">✕</button></div>' +
      items +
      '<a class="g-more" href="' + foundHref + '">Drill these in the Foundations Gym →</a>' +
      '</aside>';
    document.body.appendChild(wrap);
    wrap.addEventListener('click', function (e) {
      if (e.target.hasAttribute('data-close')) closeGlossary();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeGlossary();
    });
  }
  function openGlossary() {
    var g = document.getElementById('aal-glossary');
    if (g) { g.classList.add('open'); g.setAttribute('aria-hidden', 'false'); }
  }
  function closeGlossary() {
    var g = document.getElementById('aal-glossary');
    if (g) { g.classList.remove('open'); g.setAttribute('aria-hidden', 'true'); }
  }

  /* -------------------------------------------------- chrome injection (mode toggle + glossary + savebar + loadfile) */
  function injectChrome() {
    var nav = document.querySelector('header.chrome nav');
    if (nav && !document.getElementById('aal-mode')) {
      var gbtn = document.createElement('button');
      gbtn.id = 'aal-glossbtn';
      gbtn.type = 'button';
      gbtn.title = 'Foundations glossary';
      gbtn.setAttribute('aria-label', 'Open foundations glossary');
      gbtn.innerHTML = 'A–Z';
      gbtn.addEventListener('click', openGlossary);
      nav.appendChild(gbtn);

      var mt = document.createElement('div');
      mt.id = 'aal-mode';
      mt.className = 'modeToggle';
      mt.innerHTML = '<button type="button" data-mode="self">Self-paced</button><button type="button" data-mode="present">Present</button>';
      mt.addEventListener('click', function (e) {
        var b = e.target.closest('button[data-mode]');
        if (b) setMode(b.getAttribute('data-mode'));
      });
      nav.appendChild(mt);
    }
    if (!document.getElementById('aal-savebar')) {
      var bar = document.createElement('div');
      bar.id = 'aal-savebar';
      bar.setAttribute('aria-live', 'polite');
      bar.textContent = 'Saved automatically';
      document.body.appendChild(bar);
    }
    if (!document.getElementById('aal-loadfile')) {
      var inp = document.createElement('input');
      inp.type = 'file';
      inp.accept = 'application/json,.json';
      inp.id = 'aal-loadfile';
      inp.style.display = 'none';
      inp.addEventListener('change', function () {
        if (inp.files && inp.files[0]) importFile(inp.files[0]);
        inp.value = '';
      });
      document.body.appendChild(inp);
    }
  }

  /* -------------------------------------------------- workflow chip */
  function chip() {
    var el = document.getElementById('wfchip');
    if (!el) return;
    var wf = get('me.workflow');
    if (String(wf).trim()) {
      el.textContent = 'Your workflow: ' + wf;
      el.classList.add('on');
      el.title = 'The workflow you chose in Activity 1.3 and carry through the course';
    } else {
      el.classList.remove('on');
    }
  }

  /* -------------------------------------------------- print doc (artefact / pack PDF via browser print) */
  function printDoc(title, bodyHtml) {
    var old = document.getElementById('printdoc');
    if (old) old.remove();
    var d = document.createElement('div');
    d.id = 'printdoc';
    var wf = get('me.workflow');
    var date = new Date().toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
    d.innerHTML =
      '<div class="pd-head"><div class="pd-brand">AIM · Agentic AI for Leaders</div>' +
      '<h1>' + title + '</h1>' +
      '<div class="pd-meta">' + (wf ? 'Workflow: ' + wf + ' · ' : '') + date + '</div></div>' +
      bodyHtml +
      '<div class="pd-foot">Capability is not permission. Leaders decide. — Australian Institute of Management</div>';
    document.body.appendChild(d);
    document.body.classList.add('printing');
    var cleanup = function () {
      document.body.classList.remove('printing');
      var pd = document.getElementById('printdoc');
      if (pd) pd.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
    /* Safari sometimes skips afterprint on cancel — belt and braces */
    setTimeout(cleanup, 60000);
  }
  /* Convenience: rows = [[label, key], ...] → definition-list HTML from capture */
  function artefactRows(rows) {
    return rows.map(function (r) {
      var v = get(r[1]);
      return '<div class="pd-row"><div class="pd-label">' + r[0] + '</div><div class="pd-value">' +
        (String(v).trim() ? String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') : '<em>Not yet answered — this gap is a finding.</em>') +
        '</div></div>';
    }).join('');
  }

  /* -------------------------------------------------- boot */
  document.addEventListener('DOMContentLoaded', function () {
    var page = document.body.getAttribute('data-page') || '';
    if (page && page.charAt(0) !== '_' && page !== 'hub') {
      try { localStorage.setItem(LAST, page); } catch (e) {}
    }
    injectChrome();
    buildGlossary();
    initMode();
    wireFields();
    wireReveals();
    wireActions();
    chip();
    document.addEventListener('aal:change', function (e) {
      if (e.detail && e.detail.key === 'me.workflow') chip();
    });
  });

  /* -------------------------------------------------- public API */
  return {
    get: get, set: set, del: del, has: has,
    getCap: readAll,
    progress: progress, countWith: countWith, TOTALS: TOTALS,
    download: download, importData: importData, importFile: importFile, exportData: exportData,
    resetAll: resetAll,
    setMode: setMode,
    openGlossary: openGlossary, closeGlossary: closeGlossary,
    printDoc: printDoc, artefactRows: artefactRows,
    refreshGates: refreshGates, wireFields: wireFields
  };
})();
