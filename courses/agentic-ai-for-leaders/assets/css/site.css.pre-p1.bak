/* Agentic AI for Leaders — site.css · Phase 0 skeleton (Phase 1 completes this) */
:root{
  --teal:#00C0AF; --teal-light:#53DFCB; --teal-dark:#008D80;
  --cream:#F1EEDE; --cream-alt:#F7EBDB;
  --coral:#DC5A46; --coral-dark:#B53D2C;
  --ink:#423A3A; --black:#141414; --grey:#595959; --muted:#A7A7A7;
  --line:rgba(0,0,0,.10);
  --head:'IBM Plex Sans Condensed',sans-serif;
  --body:'IBM Plex Sans',sans-serif;
  --mono:'IBM Plex Mono',monospace;
  --maxw:1180px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--ink);background:var(--cream);line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--head);font-weight:600;letter-spacing:.2px;line-height:1.08}
a{color:inherit;text-decoration:none}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px}
.eyebrow{font-family:var(--head);font-weight:600;text-transform:uppercase;letter-spacing:.18em;font-size:12.5px}

/* chrome */
header.chrome{position:sticky;top:0;z-index:50;background:var(--teal);color:#fff;border-bottom:1px solid rgba(255,255,255,.18)}
.chrome .row{display:flex;align-items:center;gap:14px;height:60px}
.logo{display:flex;align-items:center;gap:10px}
.logo .lt{font-family:var(--head);font-weight:700;font-size:15px;line-height:1}
.logo .ls{font-size:10.5px;opacity:.85;letter-spacing:.14em;text-transform:uppercase}
.chrome nav{margin-left:auto;display:flex;align-items:center;gap:4px}
.chrome nav a{font-family:var(--head);font-weight:500;font-size:13.5px;padding:8px 12px;color:#fff;opacity:.9}
.chrome nav a:hover{opacity:1;background:rgba(255,255,255,.12)}
.wfchip{display:none;font-family:var(--head);font-size:12px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.35);padding:5px 10px;color:#fff;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wfchip.on{display:inline-block}

/* hero */
.hero{position:relative;background:var(--black);color:#fff;overflow:hidden;min-height:420px;display:flex;align-items:flex-end}
.hero .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.92}
.hero .veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.30) 0%,rgba(10,10,10,.78) 78%,rgba(10,10,10,.92) 100%)}
.hero .inner{position:relative;z-index:3;padding:64px 0 44px;width:100%}
.hero .eyebrow{color:var(--teal-light)}
.hero h1{font-size:clamp(34px,5vw,60px);font-weight:700;margin:10px 0 6px;max-width:20ch}
.hero .sub{font-size:17px;max-width:56ch;opacity:.92;font-weight:300}
.crumb{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-family:var(--head);font-size:13.5px;margin-bottom:14px}
.crumb .from{opacity:.75}
.crumb .arrow{color:var(--coral)}
.crumb .to{color:var(--teal-light);font-weight:600}
.gq{margin-top:18px;display:flex;gap:12px;max-width:62ch}
.gq .bar{width:4px;flex:0 0 4px;background:var(--coral)}
.gq p{font-family:var(--head);font-weight:500;font-size:17px}

/* stub body */
main.stub{padding:46px 0 30px}
.panel{background:#fff;border:1px solid var(--line);padding:26px 28px;margin-bottom:18px}
.panel h2{font-size:20px;margin-bottom:10px}
.panel p.lead{font-size:14.5px;color:var(--grey);margin-bottom:14px}
.panel ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.panel li{font-size:13.5px;color:var(--grey);padding-left:16px;position:relative;line-height:1.4}
.panel li::before{content:"";position:absolute;left:0;top:8px;width:5px;height:5px;background:var(--teal)}
.panel.acts li::before{background:var(--coral)}
.buildnote{background:var(--cream-alt);border-left:5px solid var(--coral);padding:14px 18px;font-size:13.5px;margin-bottom:18px}
.buildnote b{font-family:var(--head)}
.artefact{background:var(--cream-alt);border:1px solid var(--line);padding:20px 24px;margin-bottom:18px}
.artefact .chip{display:inline-block;font-family:var(--head);font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;padding:4px 8px;background:var(--coral);color:#fff;margin-bottom:8px}
.artefact h3{font-size:18px}

/* prev/next */
.pn{display:flex;justify-content:space-between;gap:14px;margin:26px 0 10px}
.pn a{font-family:var(--head);font-weight:600;font-size:14px;color:var(--teal-dark);background:#fff;border:1px solid var(--line);padding:12px 18px;flex:1;display:flex;flex-direction:column;gap:2px}
.pn a:hover{border-color:var(--teal-dark)}
.pn a.next{text-align:right;align-items:flex-end}
.pn .lbl{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}

footer{background:var(--ink);color:#fff;margin-top:40px;padding:30px 0}
footer .row{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
footer .lt{font-family:var(--head);font-weight:600;font-size:14px}
footer small{color:var(--muted);font-size:12px}
.tick{width:26px;height:3px;background:#fff;margin-bottom:8px}

/* hub stub cards */
.band{margin:34px 0 8px}
.band .label{display:flex;align-items:center;gap:14px;margin:0 0 16px}
.band .label .tag{font-family:var(--head);font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:var(--coral);padding:6px 12px}
.band .label .tag.d2{background:var(--teal-dark)}
.band .label .tag.zero{background:var(--ink)}
.band .label h3{font-size:20px;font-weight:600}
.band .label .ln{flex:1;height:1px;background:var(--line)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(max-width:820px){.grid{grid-template-columns:1fr}}
.card{position:relative;background:#fff;border:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden;transition:.2s}
.card:hover{transform:translateY(-3px);box-shadow:0 16px 40px -22px rgba(0,0,0,.45)}
.card .accent{height:5px;background:var(--teal)}
.card.coral .accent{background:var(--coral)}
.card .pad{padding:18px 20px 20px}
.card .kicker{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.card .chip{font-family:var(--head);font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;padding:4px 8px;background:var(--cream);color:var(--teal-dark)}
.card .chip.flex{background:transparent;color:var(--muted);padding-left:0}
.card h4{font-size:19px;margin-bottom:3px}
.card .dash{font-family:var(--head);font-weight:600;font-size:13px;color:var(--teal-dark);margin-bottom:8px}
.card .desc{font-size:13.5px;color:var(--grey)}
.card .foot{margin-top:14px;border-top:1px solid var(--line);padding-top:11px;font-family:var(--head);font-weight:600;font-size:13px;color:var(--teal-dark)}

/* accessibility */
a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
header.chrome a:focus-visible{outline-color:#fff;outline-offset:-3px}
.skip-link{position:absolute;left:8px;top:-60px;z-index:200;background:var(--ink);color:#fff;font-family:var(--head);font-weight:600;font-size:13px;padding:10px 16px;transition:top .15s}
.skip-link:focus{top:8px}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
  .card:hover{transform:none!important}
}
