<style>
main.mod{padding:10px 0 30px}
.msec{margin:44px 0}
.msec > h2{font-size:26px;margin-bottom:6px}
.msec > .sec-eyebrow{font-family:var(--head);font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--coral-dark);margin-bottom:6px}
.msec > p.body{font-size:15px;color:var(--ink);max-width:72ch;margin:10px 0;line-height:1.6}
.msec > p.body.dim{color:var(--grey)}
.secimg{width:100%;max-height:340px;object-fit:cover;margin:14px 0;display:block}
/* 48h clock */
#clock48{position:fixed;right:18px;top:74px;z-index:90;background:#141414;color:#fff;border:1px solid rgba(220,90,70,.6);padding:8px 14px;font-family:var(--mono);font-size:12px;display:none;box-shadow:0 10px 30px -14px rgba(0,0,0,.5)}
#clock48.on{display:block}
#clock48 .cl{color:var(--coral);font-size:10px;letter-spacing:.12em;text-transform:uppercase;display:block;margin-bottom:2px;font-family:var(--head);font-weight:700}
#clock48 b{font-size:16px;font-weight:600;letter-spacing:.06em}
@media(max-width:760px){#clock48{top:auto;bottom:64px;right:12px}}
/* decision log */
.dlog{background:#fff;border:1px solid var(--line);margin:16px 0}
.dlog .dl-head{background:#141414;color:#fff;padding:12px 18px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-family:var(--mono);font-size:11px;letter-spacing:.06em}
.dlog .dl-head b{color:#53DFCB}
.dl-sec{background:var(--cream);font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--grey);padding:7px 18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.dl-row{display:grid;grid-template-columns:210px 1fr;border-bottom:1px solid var(--line);cursor:pointer;transition:.12s}
.dl-row:hover{background:var(--cream-alt)}
.dl-row .k{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--grey);padding:10px 18px}
.dl-row .v{font-size:13px;padding:10px 14px;line-height:1.5}
.dl-row .v .pill{font-family:var(--mono);font-size:11px;padding:3px 8px;border:1.5px dashed var(--grey)}
.dl-row .v .pill.solid{background:#141414;color:#fff;border:0}
.dl-row .v .pill.sev{border:1.5px solid var(--ink);font-weight:600}
.dl-row.marked{background:rgba(0,192,175,.09)}
.dl-row.marked .k::before{content:"✓ ";color:var(--teal-dark);font-weight:700}
@media(max-width:640px){.dl-row{grid-template-columns:1fr}.dl-row .k{padding-bottom:0}}
/* revealed state */
.dlog.judged .dl-row{cursor:default}
.dlog.judged .dl-row:not(.marked){opacity:.45}
.dl-gap{display:none;grid-template-columns:210px 1fr;border-bottom:1px solid rgba(220,90,70,.4);background:rgba(220,90,70,.07)}
.dlog.judged .dl-gap{display:grid}
.dl-gap .k{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--coral-dark);padding:10px 18px;font-weight:600}
.dl-gap .v{font-family:var(--mono);font-size:12px;color:var(--coral-dark);padding:10px 14px}
@media(max-width:640px){.dl-gap{grid-template-columns:1fr}}
.marknote{font-family:var(--head);font-weight:600;font-size:12.5px;color:var(--teal-dark);margin:8px 0}
/* pitfalls */
.pits{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0}
@media(max-width:860px){.pits{grid-template-columns:1fr}}
.pit{background:#fff;border:1px solid var(--line);border-top:4px solid var(--coral);padding:16px 18px}
.pit h5{font-family:var(--head);font-size:15px;margin-bottom:7px}
.pit p{font-size:12.8px;color:var(--grey);line-height:1.5}
/* visibility four */
.vis4{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:14px 0}
@media(max-width:820px){.vis4{grid-template-columns:1fr}}
.vis{background:var(--ink);color:#fff;padding:18px 20px}
.vis .vn{font-family:var(--mono);font-size:11px;color:var(--teal-light);letter-spacing:.1em}
.vis h4{font-size:18px;color:#fff;margin:4px 0 6px}
.vis p{font-size:13px;color:rgba(255,255,255,.82);line-height:1.5}
.vis .anchor{margin-top:10px;font-family:var(--head);font-weight:500;font-size:12.8px;color:var(--teal-light);border-top:1px solid rgba(255,255,255,.2);padding-top:9px}
/* roles */
.roles{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.role{font-family:var(--head);font-weight:600;font-size:12.5px;background:#fff;border:1px solid var(--line);padding:8px 13px}
/* agent-type comparator */
.types{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0}
@media(max-width:860px){.types{grid-template-columns:1fr}}
.type{background:#fff;border:1px solid var(--line);border-top:4px solid var(--teal-dark);padding:16px 18px}
.type h5{font-family:var(--head);font-size:15px;margin-bottom:6px}
.type p{font-size:12.6px;color:var(--grey);line-height:1.5;margin-bottom:8px}
.type .lq{font-family:var(--head);font-weight:600;font-size:12.8px;color:var(--teal-dark)}
/* observable info picker */
.obs{display:flex;flex-direction:column;gap:8px;margin:12px 0}
.obs label{display:flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid var(--line);padding:11px 14px;font-size:13.5px;cursor:pointer}
.obs label:hover{border-color:var(--teal-dark)}
.obs input{margin-top:2px;accent-color:var(--teal-dark)}
/* partners */
.partners{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}
@media(max-width:760px){.partners{grid-template-columns:1fr}}
.partners label{display:flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid var(--line);padding:11px 14px;font-size:12.8px;line-height:1.4;cursor:pointer}
.partners input{margin-top:2px;accent-color:var(--teal-dark)}
.partners b{font-family:var(--head);display:block;font-size:13px}
/* day 1 summary */
.d1band{background:var(--ink);color:#fff;padding:30px 30px;margin:40px 0 10px}
.d1band h2{font-size:24px;color:#fff;margin-bottom:4px}
.d1band .sub{font-size:13.5px;color:rgba(255,255,255,.75);margin-bottom:18px}
.d1arts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}
@media(max-width:860px){.d1arts{grid-template-columns:repeat(2,1fr)}}
.d1art{border:1px solid rgba(255,255,255,.25);padding:12px;font-family:var(--head)}
.d1art .st{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5)}
.d1art.ok .st{color:var(--teal-light)}
.d1art .nm{font-weight:600;font-size:12.5px;margin-top:5px;line-height:1.3}
.d1band .field label{color:rgba(255,255,255,.85)}
.d1band textarea{background:rgba(255,255,255,.95)}
.takeaways{background:#fff;border:1px solid var(--line);padding:22px 26px}
.takeaways ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.takeaways li{font-size:14px;line-height:1.5;padding-left:22px;position:relative}
.takeaways li::before{content:"→";position:absolute;left:0;color:var(--coral);font-weight:700}
</style>
