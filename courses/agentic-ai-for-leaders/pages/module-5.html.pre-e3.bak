<style>
main.mod{padding:10px 0 30px}
.msec{margin:44px 0}
.msec > h2{font-size:26px;margin-bottom:6px}
.msec > .sec-eyebrow{font-family:var(--head);font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--teal-dark);margin-bottom:6px}
.msec > p.body{font-size:15px;color:var(--ink);max-width:72ch;margin:10px 0;line-height:1.6}
.msec > p.body.dim{color:var(--grey)}
.secimg{width:100%;max-height:340px;object-fit:cover;margin:14px 0;display:block}
/* day 2 reframe evidence chips */
.evchips{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0}
@media(max-width:860px){.evchips{grid-template-columns:repeat(2,1fr)}}
.evchip{border:1px solid var(--line);background:#fff;padding:12px 14px;font-family:var(--head)}
.evchip .st{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.evchip.ok .st{color:var(--teal-dark)}
.evchip .nm{font-weight:600;font-size:12.5px;margin-top:4px;line-height:1.3}
/* proposal dossier */
.dossier{background:#141414;color:#d9d4c8;padding:24px 26px;margin:16px 0}
.dossier .dh{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#53DFCB;margin-bottom:12px}
.dossier h5{font-family:var(--head);font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#fff;margin:14px 0 8px}
.dossier ol{margin-left:18px;display:flex;flex-direction:column;gap:4px}
.dossier ol li,.dossier ul li{font-size:13px;line-height:1.5}
.dossier ul{list-style:none;display:flex;flex-direction:column;gap:5px}
.dossier ul li{padding-left:14px;position:relative}
.dossier ul li::before{content:"·";position:absolute;left:2px;color:#53DFCB}
.dossier .vendorline{border:1.5px dashed rgba(255,255,255,.4);padding:10px 14px;margin:12px 0;font-style:italic;font-size:13.5px}
.dossier .warn{color:var(--coral)}
.dstats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0 4px}
@media(max-width:760px){.dstats{grid-template-columns:repeat(2,1fr)}}
.dstat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);padding:12px;text-align:center}
.dstat b{display:block;font-family:var(--head);font-weight:700;font-size:24px;color:#53DFCB}
.dstat span{font-size:10.5px;line-height:1.3;display:block;margin-top:4px;color:rgba(255,255,255,.7)}
/* zones */
.zones{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}
@media(max-width:820px){.zones{grid-template-columns:1fr}}
.zone{background:#fff;border:1px solid var(--line);border-top:4px solid var(--teal-dark);padding:14px 16px}
.zone.z7{grid-column:1/-1}
.zone .zn{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.08em}
.zone h5{font-family:var(--head);font-size:15px;margin:3px 0 4px}
.zone .zq{font-size:12.5px;color:var(--grey);line-height:1.4;margin-bottom:8px}
.zone textarea{min-height:60px;font-size:13px}
/* criteria */
.crit{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:14px 0}
@media(max-width:820px){.crit{grid-template-columns:1fr}}
.cr{background:var(--ink);color:#fff;padding:16px 18px}
.cr .cn{font-family:var(--mono);font-size:11px;color:var(--teal-light)}
.cr h4{font-size:17px;color:#fff;margin:4px 0 5px}
.cr p{font-size:12.8px;color:rgba(255,255,255,.82);line-height:1.5}
.cr .kq{margin-top:9px;font-family:var(--head);font-weight:600;font-size:13px;color:var(--teal-light);border-top:1px solid rgba(255,255,255,.2);padding-top:8px}
/* weighting + patterns */
.weigh{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
@media(max-width:820px){.weigh{grid-template-columns:1fr}}
.wg{background:#fff;border:1px solid var(--line);padding:13px 15px;font-size:12.6px;color:var(--grey)}
.wg b{font-family:var(--head);display:block;font-size:13.5px;color:var(--ink);margin-bottom:4px}
.pats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
@media(max-width:820px){.pats{grid-template-columns:1fr}}
.pat{background:var(--cream-alt);border-left:4px solid var(--coral);padding:13px 15px;font-size:12.8px}
.pat b{font-family:var(--head);display:block;margin-bottom:3px}
/* RPN rows */
.rpnrow{background:#fff;border:1px solid var(--line);padding:14px 16px;margin-bottom:10px}
.rpnrow .rh{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:8px}
.rpnrow h5{font-family:var(--head);font-size:14.5px}
.rpnrow .rq{font-size:12.3px;color:var(--grey);margin-top:2px}
.seg{display:flex;border:1.5px solid rgba(66,58,58,.3)}
.seg label{position:relative;cursor:pointer}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg .sl{display:block;font-family:var(--head);font-weight:700;font-size:12px;padding:8px 13px;border-right:1.5px solid rgba(66,58,58,.3);color:var(--grey);min-width:40px;text-align:center}
.seg label:last-child .sl{border-right:0}
.seg label:nth-child(1) input:checked + .sl{background:var(--teal-dark);color:#fff}
.seg label:nth-child(2) input:checked + .sl{background:var(--coral);color:#fff}
.seg label:nth-child(3) input:checked + .sl{background:var(--ink);color:#fff}
.seg input:focus-visible + .sl{outline:3px solid var(--teal);outline-offset:2px}
.takeaways{background:#fff;border:1px solid var(--line);padding:22px 26px}
.takeaways ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.takeaways li{font-size:14px;line-height:1.5;padding-left:22px;position:relative}
.takeaways li::before{content:"→";position:absolute;left:0;color:var(--teal-dark);font-weight:700}
.guide{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:12px 0}
@media(max-width:820px){.guide{grid-template-columns:1fr}}
.gcol{background:#fff;border:1px solid var(--line);padding:16px 18px}
.gcol h5{font-family:var(--head);font-size:14px;margin-bottom:8px;color:var(--teal-dark)}
.gcol ul{list-style:none;display:flex;flex-direction:column;gap:5px}
.gcol li{font-size:12.6px;color:var(--grey);padding-left:14px;position:relative;line-height:1.4}
.gcol li::before{content:"";position:absolute;left:0;top:7px;width:5px;height:5px;background:var(--teal)}
.sampletab{background:#fff;border:1px solid var(--line);margin-top:10px}
.sampletab .srow{display:grid;grid-template-columns:190px 60px 1fr;border-bottom:1px solid var(--line);font-size:12.6px}
.sampletab .srow:last-child{border-bottom:0}
.sampletab .sk{font-family:var(--head);font-weight:600;padding:9px 12px;background:var(--cream)}
.sampletab .sv{padding:9px 12px;color:var(--grey);font-style:italic}
.sampletab .sr{padding:9px 6px;font-family:var(--mono);font-weight:600;text-align:center}
@media(max-width:640px){.sampletab .srow{grid-template-columns:1fr}}
</style>
