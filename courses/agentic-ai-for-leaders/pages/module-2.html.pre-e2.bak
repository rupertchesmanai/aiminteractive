<footer><div class="wrap row"><div><div class="tick"></div><div class="lt">Agentic AI for Leaders</div><small>Australian Institute of Management — Interactive Workbook</small></div><small>Capability is not permission. Leaders decide.</small></div></footer>

<script src="../assets/js/site.js"></script>
<script>
document.addEventListener('DOMContentLoaded',function(){
  /* 13% flip */
  document.getElementById('flip13').addEventListener('click',function(){this.classList.toggle('on');});

  /* delta: A2.2 snapshot level vs A2.1 first call */
  function normLevel(v){
    if(/full/i.test(v))return 'Full';
    if(/partial/i.test(v))return 'Partial';
    if(/not|none/i.test(v))return 'None yet';
    return v;
  }
  function delta(){
    var first=AAL.get('m2.a21.level'), now=AAL.get('m2.snap.level');
    var el=document.getElementById('a22delta');
    if(first && now && normLevel(first)!==normLevel(now)){
      el.className='delta on';
      el.innerHTML='<b>You moved from “'+normLevel(first)+'” to “'+normLevel(now)+'”.</b> That movement is the lenses doing their job — capture what moved you in your defence sentence below.';
    } else if(first && now){
      el.className='delta on';
      el.style.background='rgba(0,141,128,.08)';el.style.borderLeftColor='var(--teal-dark)';
      el.innerHTML='<b>Your position held under the lenses.</b> A decision that survives structured challenge is stronger than one that was never tested — make the defence sentence carry that.';
    } else { el.className='delta'; }
  }

  /* snapshot meter */
  var SNAP=['m2.snap.level','m2.snap.condition','m2.snap.trigger','m2.snap.defence'];
  function meter(){
    var n=SNAP.filter(function(k){return AAL.has(k)}).length;
    document.getElementById('snapfill').style.width=(n/4*100)+'%';
    document.getElementById('snappct').textContent=n+' of 4 parts named';
  }

  /* a23 workflow mention */
  function wf(){
    var w=AAL.get('me.workflow');
    document.getElementById('a23wf').textContent = w? ' — “'+w+'”':'';
  }

  /* artefact */
  var ROWS=[
    ['The agent (shared case)','m2.snap.agent__static'],
    ['Case autonomy level','m2.snap.level'],
    ['The condition','m2.snap.condition'],
    ['The trigger','m2.snap.trigger'],
    ['The defence','m2.snap.defence'],
    ['My workflow — autonomy level','m2.a23.level'],
    ['My workflow — main value','m2.a23.value'],
    ['My workflow — lens that matters most','m2.a23.lens'],
    ['My workflow — why that lens','m2.a23.lenswhy'],
    ['My workflow — pause/withdraw trigger','m2.a23.trigger']
  ];
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')}
  function rowVal(k){
    if(k==='m2.snap.agent__static')return 'Complaint Triage Agent';
    return AAL.get(k);
  }
  function drawArtefact(){
    document.getElementById('m2rows').innerHTML=ROWS.map(function(r){
      var v=rowVal(r[1]);
      return '<div class="ap-row"><div class="k">'+r[0]+'</div><div class="v">'+
        (String(v).trim()?esc(v):'<em>Not yet answered — this gap is a finding.</em>')+'</div></div>';
    }).join('');
  }
  document.getElementById('m2print').addEventListener('click',function(){
    var rows=ROWS.map(function(r){return [r[0], r[1]==='m2.snap.agent__static'?null:r[1]];});
    var html=ROWS.map(function(r){
      var v=rowVal(r[1]);
      return '<div class="pd-row"><div class="pd-label">'+r[0]+'</div><div class="pd-value">'+
        (String(v).trim()?esc(v).replace(/\n/g,'<br>'):'<em>Not yet answered — this gap is a finding.</em>')+'</div></div>';
    }).join('');
    AAL.printDoc('Autonomy Decision Snapshot', html);
  });

  function refresh(){delta();meter();wf();drawArtefact();}
  refresh();
  document.addEventListener('aal:change',refresh);
});
</script>
</body>
</html>
