<style>
main.mod{padding:10px 0 30px}
.msec{margin:44px 0}
.msec > h2{font-size:26px;margin-bottom:6px}
.msec > .sec-eyebrow{font-family:var(--head);font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--coral-dark);margin-bottom:6px}
.msec > p.body{font-size:15px;color:var(--ink);max-width:72ch;margin:10px 0;line-height:1.6}
.msec > p.body.dim{color:var(--grey)}
.secimg{width:100%;max-height:340px;object-fit:cover;margin:14px 0;display:block}
/* value question checklist */
.vq{display:flex;flex-direction:column;gap:8px;margin:14px 0}
.vq .q{background:#fff;border:1px solid var(--line);border-left:4px solid var(--teal-dark);padding:12px 16px;font-family:var(--head);font-weight:500;font-size:14.5px}
/* case dossier */
.dossier{background:#141414;color:#d9d4c8;padding:24px 26px;margin:16px 0}
.dossier .dh{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#53DFCB;margin-bottom:12px}
.dossier .cols{display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media(max-width:820px){.dossier .cols{grid-template-columns:1fr}}
.dossier h5{font-family:var(--head);font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#fff;margin:0 0 8px}
.dossier ul{list-style:none;display:flex;flex-direction:column;gap:5px}
.dossier li{font-size:13px;line-height:1.45;padding-left:14px;position:relative}
.dossier li::before{content:"·";position:absolute;left:2px;color:#53DFCB}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0 4px}
@media(max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}}
.stat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);padding:14px 12px;text-align:center}
.stat b{display:block;font-family:var(--head);font-weight:700;font-size:30px;color:#53DFCB}
.stat.warn b{color:var(--coral)}
.stat span{font-size:11px;line-height:1.3;display:block;margin-top:4px;color:rgba(255,255,255,.7)}
.routes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0}
@media(max-width:760px){.routes{grid-template-columns:repeat(2,1fr)}}
.route{background:var(--cream-alt);border:1px solid var(--line);padding:12px 14px;font-family:var(--head);font-weight:600;font-size:13px;text-align:center}
/* lenses */
.lensgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0}
@media(max-width:820px){.lensgrid{grid-template-columns:1fr}}
.lens{background:#fff;border:1px solid var(--line);border-top:4px solid var(--teal-dark);padding:18px 20px}
.lens .ln{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.1em}
.lens h4{font-size:18px;margin:5px 0 6px}
.lens .cq{font-family:var(--head);font-weight:600;font-size:14px;color:var(--teal-dark);margin-bottom:8px}
.lens p{font-size:13px;color:var(--grey);line-height:1.5}
/* delta note */
.delta{display:none;background:rgba(220,90,70,.09);border-left:5px solid var(--coral-dark);padding:14px 18px;margin:12px 0;font-size:14px}
.delta.on{display:block}
/* 13% flip */
.flip13{background:var(--ink);color:#fff;border:0;cursor:pointer;padding:16px 20px;font-family:var(--head);font-weight:600;font-size:15px;width:100%;text-align:left}
.flip13 .ans{display:none;color:var(--teal-light);margin-top:8px;font-size:16px}
.flip13.on .ans{display:block}
.takeaways{background:#fff;border:1px solid var(--line);padding:22px 26px}
.takeaways ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.takeaways li{font-size:14px;line-height:1.5;padding-left:22px;position:relative}
.takeaways li::before{content:"→";position:absolute;left:0;color:var(--coral);font-weight:700}
</style>
