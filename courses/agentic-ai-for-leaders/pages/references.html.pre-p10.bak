.ref .rm{font-family:var(--mono);font-size:11px;color:var(--muted);margin:5px 0 7px}
.ref p{font-size:12.8px;color:var(--grey);line-height:1.5}
.ref .go{font-family:var(--head);font-weight:600;font-size:12px;color:var(--teal-dark);margin-top:8px;display:inline-block}
