<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/css/site.css">
<style>
.founds{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:14px 0 6px}
@media(max-width:900px){.founds{grid-template-columns:repeat(2,1fr)}}
.found{display:block;background:#fff;border:1px solid var(--line);border-top:4px solid var(--teal-dark);padding:14px 14px 12px;transition:.15s}
.found:hover{transform:translateY(-2px);box-shadow:0 12px 30px -18px rgba(0,0,0,.4)}
.found .fn{font-family:var(--mono);font-size:10.5px;color:var(--muted);letter-spacing:.08em}
.found h4{font-size:14.5px;line-height:1.25;margin:6px 0 6px}
.found .go{font-family:var(--head);font-weight:600;font-size:11.5px;color:var(--teal-dark)}
.isnt{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0}
@media(max-width:700px){.isnt{grid-template-columns:1fr}}
.isnt .col{background:#fff;border:1px solid var(--line);padding:20px 22px}
.isnt .col.no{background:var(--cream-alt)}
.isnt h4{font-size:16px;margin-bottom:10px}
.isnt .col.no h4{color:var(--coral-dark)}
.isnt ul{list-style:none;display:flex;flex-direction:column;gap:7px}
.isnt li{font-size:13.5px;color:var(--grey);padding-left:20px;position:relative;line-height:1.4}
.isnt .col.is li::before{content:"✓";position:absolute;left:0;color:var(--teal-dark);font-weight:700}
.isnt .col.no li::before{content:"✕";position:absolute;left:0;color:var(--coral-dark);font-weight:700}
.wbs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0}
@media(max-width:800px){.wbs{grid-template-columns:1fr}}
.wb{background:#fff;border:1px solid var(--line);padding:18px 20px}
.wb .tag{font-family:var(--head);font-weight:700;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--ink);padding:4px 8px;display:inline-block;margin-bottom:9px}
.wb.site .tag{background:var(--teal-dark)}
.wb h4{font-size:16px;margin-bottom:5px}
.wb p{font-size:13px;color:var(--grey)}
.pulse{margin:18px 0 6px}
.pulse .p-row{background:#fff;border:1px solid var(--line);padding:18px 20px;margin-bottom:12px}
.pulse .p-q{font-family:var(--head);font-weight:600;font-size:15px;margin-bottom:12px}
.pulse .p-scale{display:flex;align-items:center;gap:14px}
.pulse .p-scale input{flex:1}
.pulse .p-ends{display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted);margin-top:6px}
.pulse .p-val{font-family:var(--head);font-weight:700;font-size:20px;color:var(--teal-dark);min-width:34px;text-align:center}
</style>
</head>
<body data-page="welcome">
