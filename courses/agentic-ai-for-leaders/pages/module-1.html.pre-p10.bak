/* ---------- canvas ---------- */
.pathcards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:12px 0}
@media(max-width:760px){.pathcards{grid-template-columns:1fr}}
.promptbox{background:#141414;color:#d9d4c8;font-family:var(--mono);font-size:12px;line-height:1.6;padding:16px 18px;margin:10px 0;position:relative;white-space:pre-wrap}
.promptbox .copybtn{position:absolute;top:10px;right:10px}
.guide{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:12px 0}
@media(max-width:820px){.guide{grid-template-columns:1fr}}
