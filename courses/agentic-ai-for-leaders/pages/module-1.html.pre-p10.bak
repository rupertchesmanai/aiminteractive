<style>
/* ---------- module content shell ---------- */
main.mod{padding:10px 0 30px}
.msec{margin:44px 0}
.msec > h2{font-size:26px;margin-bottom:6px}
.msec > .sec-eyebrow{font-family:var(--head);font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--coral-dark);margin-bottom:6px}
.msec > p.body{font-size:15px;color:var(--ink);max-width:72ch;margin:10px 0;line-height:1.6}
.msec > p.body.dim{color:var(--grey)}
.secimg{width:100%;max-height:360px;object-fit:cover;margin:14px 0;display:block}
/* ---------- agent judgement cards (A1.1) ---------- */
.agents{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0}
@media(max-width:960px){.agents{grid-template-columns:1fr}}
.agent{background:#fff;border:1px solid var(--line);border-top:5px solid var(--ink);padding:18px 20px;display:flex;flex-direction:column}
.agent .an{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--muted);margin-bottom:4px}
.agent h4{font-size:18px;margin-bottom:10px}
.agent .fact{font-size:13px;line-height:1.5;margin-bottom:8px;color:var(--grey)}
.agent .fact b{font-family:var(--head);font-weight:600;color:var(--ink);display:block;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase}
.agent .verdict{margin-top:auto;border-top:1px solid var(--line);padding-top:12px}
.agent .verdict .vl{font-family:var(--head);font-weight:600;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--coral-dark);margin-bottom:8px}
.vopt{display:flex;gap:8px;align-items:flex-start;font-size:12.8px;line-height:1.35;cursor:pointer;padding:7px 8px;border:1.5px solid transparent}
.vopt:hover{background:var(--cream)}
.vopt input{margin-top:2px;accent-color:var(--teal-dark)}
.vopt.checked{border-color:var(--teal-dark);background:rgba(0,192,175,.07)}
.agent .whyf input{margin-top:8px}
/* decision verb highlight in reveal */
.dv{background:rgba(220,90,70,.16);border-bottom:2px solid var(--coral);padding:0 2px;font-weight:600}
/* ---------- participation lanes ---------- */
.lanes{margin:16px 0}
.lane-tabs{display:flex;gap:6px;flex-wrap:wrap}
.lane-tabs button{font-family:var(--head);font-weight:600;font-size:13px;padding:11px 18px;border:1px solid var(--line);background:#fff;color:var(--ink);cursor:pointer;border-bottom:3px solid transparent}
.lane-tabs button.on{border-bottom-color:var(--coral);background:var(--cream-alt)}
.lane-panel{background:#fff;border:1px solid var(--line);padding:22px 24px;display:none}
.lane-panel.on{display:block}
.lane-panel .lp-def{font-size:14.5px;line-height:1.6;max-width:72ch}
.lane-panel .lp-ex{background:var(--cream-alt);padding:12px 16px;margin:12px 0;font-size:13.5px}
.lane-panel .lp-onb{border-left:4px solid var(--teal-dark);padding:10px 16px;margin:12px 0;font-size:13.5px;color:var(--grey)}
.lane-panel .lp-onb b{color:var(--ink)}
.lane-panel .lp-q{font-family:var(--head);font-weight:600;font-size:14px;color:var(--teal-dark);margin-top:12px}
/* ---------- triptych ---------- */
.trip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0}
