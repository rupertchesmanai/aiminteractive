.trip .tcard{background:var(--ink);color:#fff;padding:20px 22px}
.trip .tn{font-family:var(--mono);font-size:11px;color:var(--teal-light);letter-spacing:.1em;margin-bottom:6px}
.trip h4{font-size:19px;color:#fff;margin-bottom:8px}
.trip p{font-size:13.5px;color:rgba(255,255,255,.85);line-height:1.5}
